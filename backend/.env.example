APP_NAME=MPLADS AI Monitoring
APP_ENV=development
# Local development:
# DATABASE_URL=sqlite:///./mplads.db
# Supabase PostgreSQL (keep the password private):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
DATABASE_URL=sqlite:///./mplads.db
UPLOAD_DIR=./uploads
RETAIN_UPLOADED_FILES=false
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_ROWS=1000000
MAX_UPLOAD_COLUMNS=500
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
GENERAL_RATE_LIMIT_PER_MINUTE=60
EXPENSIVE_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_MB=5
HSTS_ENABLED=false
PII_SCAN_ENABLED=true
PII_SAMPLE_SIZE=1000
PII_MASKING_ENABLED=true
SECURITY_SCAN_ENABLED=true
SECURITY_MONITORING_ENABLED=true
SECURITY_ALERT_DEDUP_WINDOW_SECONDS=300
MODEL_DIR=./trained_models
# Authentication configuration (use a long random secret outside development)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_MINUTES=30
AUTH_ALLOWED_EMAIL_DOMAINS=gov.in,nic.in
# Set only in development/demo mode to provision clearly fake demo accounts.
AUTH_DEMO_PASSWORD=
STATE_CAN_PROVISION_USERS=true
# Stage 6: generate a base64-encoded 32-byte key with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep the real key only in the local environment or a production secret manager.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=v1
# Optional rotation format: APP_ENCRYPTION_KEYS=v1:<base64-key>,v2:<base64-key>
APP_ENCRYPTION_KEYS=
